<script>
// --- CAMERA TRACKING SETUP ---
const video = document.getElementById("cam");
const canvas = document.getElementById("view");
const ctx = canvas.getContext("2d");

navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } })
  .then(stream => video.srcObject = stream);

let lastFrame = null;
let yaw = 0;
let pitch = 0;

function getFeatures(frame) {
  const features = [];
  for (let i = 0; i < frame.data.length; i += 4 * 200) {
    const brightness = frame.data[i] + frame.data[i+1] + frame.data[i+2];
    if (brightness > 200) features.push(i);
  }
  return features;
}

function track() {
  ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
  let frame = ctx.getImageData(0, 0, canvas.width, canvas.height);

  if (lastFrame) {
    let features = getFeatures(frame);
    let yawSum = 0;
    let pitchSum = 0;

    for (let f of features) {
      let diff = frame.data[f] - lastFrame.data[f];
      yawSum += diff;
      pitchSum += diff * 0.5;
    }

    yaw = yawSum * 0.0005;
    pitch = pitchSum * 0.0005;
  }

  lastFrame = frame;
  requestAnimationFrame(track);
}

track();

// --- VR CAMERA UPDATE LOOP ---
function updateVRCamera() {
  // Apply tracking values to your VR camera
  camera.rotation.y += yaw;   // left/right
  camera.rotation.x += pitch; // up/down

  requestAnimationFrame(updateVRCamera);
}

updateVRCamera();
</script>
